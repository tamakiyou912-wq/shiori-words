# Embedded local Postgres-compatible database. In production, use a pooled
# PostgreSQL URL such as Neon's `-pooler` connection string.
DATABASE_URL=file:./data/shiori

# Optional direct PostgreSQL URL used only by `npm run db:migrate`.
# DATABASE_MIGRATION_URL=

# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=

# Optional cookie names. Session values are random opaque tokens whose hashes
# are stored in PostgreSQL, so this app does not need AUTH_SECRET/SESSION_SECRET.
SESSION_COOKIE_NAME=shiori_session
GUEST_COOKIE_NAME=shiori_guest

# Provider defaults remain editable per user in Settings.
DEFAULT_AI_PROVIDER=deepseek
DEFAULT_AI_BASE_URL=https://api.deepseek.com
DEFAULT_AI_MODEL=deepseek-v4-flash
